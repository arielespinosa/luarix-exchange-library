# Variables que lee ESTE paquete (luarix-exchange-library) y NADA MÁS.
#
# Sirven solo para PRUEBAS LOCALES -- cuadernos de `notebooks/`, scripts
# sueltos. En producción las credenciales las pasa el backend, una por
# usuario:
#
#     BrokerFactory.get_broker(
#         AvailableBrokers.BITUNIX,
#         credentials=BrokerCredentials(api_key=..., api_secret=...),
#     )
#
# Sin `credentials`, la factory cae a estas variables (ver
# `brokers/credentials.py::BrokerCredentials.from_env`).
#
# Copiar a `.env` y rellenar. El `.env` está en `.gitignore`; este ejemplo
# NO debe llevar nunca una clave real.

# --- Modo de operación ---------------------------------------------------
# paper | testnet | live
TRADING_MODE=testnet
# Segundo candado: para colocar órdenes con dinero real hacen falta LOS DOS,
# TRADING_MODE=live Y esto en true.
ALLOW_LIVE_TRADING=false

# --- Binance -------------------------------------------------------------
# Producción (mainnet, dinero real).
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet (https://testnet.binance.vision) -- dinero ficticio. Son claves
# DISTINTAS de las de producción, no las mismas con un interruptor.
BINANCE_TEST_API_KEY=
BINANCE_TEST_API_SECRET=

# --- Bitunix -------------------------------------------------------------
# Bitunix NO tiene testnet: estas claves son de producción y operan con
# dinero real. La misma key da acceso a spot y a futuros.
#
# ⚠ Las API keys de Bitunix están restringidas por IP. Si la IP de la
# máquina no está en la whitelist, TODA llamada firmada falla con
# `code=10004 Invalid IP` (los klines, que son públicos, siguen yendo).
# La IP que hay que poner en la whitelist es la que devuelve
#     curl https://fapi.bitunix.com/cdn-cgi/trace     (campo `ip=`)
# y NO la de un "what is my IP" genérico -- pueden no coincidir.
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
